# Skopiuj do .env i uzupełnij. Plik .env nigdy nie trafia do repozytorium.

# Port, na którym słucha serwer
PORT=3000

# Ścieżka do pliku bazy SQLite. Na hostingu musi wskazywać na trwały wolumen.
DB_PATH=./dane/asystent.db

# Token dla konektora MCP (Claude). Wygeneruj długi losowy ciąg, np.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# Hasło do aplikacji webowej
APP_PASSWORD=

# Sekret do podpisywania ciasteczka sesji. Wygeneruj tak jak MCP_TOKEN.
SESSION_SECRET=

# Strefa czasowa używana do wyznaczania granic doby
TZ_APP=Europe/Warsaw
