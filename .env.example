# Skopiuj do .env i uzupełnij (albo uruchom: npm run setup).
# Plik .env nigdy nie trafia do repozytorium.

# Port, na którym słucha serwer
PORT=3000

# Katalog danych: rejestr.db i podkatalog uzytkownicy/ z dziennikami.
# Na hostingu musi wskazywać na trwały wolumen.
DANE_KATALOG=./dane

# Sekret do podpisywania ciasteczka sesji. Wygeneruj długi losowy ciąg, np.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Podpisuje też linki „wypisz mnie" ze stopki maili — wymiana klucza wylogowuje
# wszystkich i unieważnia te linki.
SESSION_SECRET=

# Domyślna strefa czasowa (kont zakładanych bez własnej)
TZ_APP=Europe/Warsaw

# --- Poczta wychodząca (Resend) -------------------------------------------
# Komplet czterech zmiennych albo żadnej. Bez nich aplikacja działa, zapisy na
# listę oczekujących też — tylko maile powitalne i powiadomienia nie wychodzą.
# Widać to w /zdrowie jako "poczta": false.
RESEND_API_KEY=
MAIL_OD=Lifelog <powitanie@twojadomena.pl>
MAIL_GOSPODARZ=
# Bez ukośnika na końcu — z tego powstają linki w mailach.
PUBLICZNY_ADRES=https://twojadomena.pl

# --- Powiadomienia push (VAPID) -------------------------------------------
# Komplet trzech zmiennych albo żadnej. Bez nich aplikacja działa w całości,
# tylko przypomnienia o treningu i kaloriach nie wychodzą.
# Widać to w /zdrowie jako "push": false.
#
# Klucze generuje się RAZ i zostawia na zawsze:
#   npx web-push generate-vapid-keys
# Ich wymiana unieważnia WSZYSTKIE subskrypcje — każdy musi włączyć
# powiadomienia od nowa.
VAPID_PUBLICZNY=
VAPID_PRYWATNY=
# Kontakt do właściciela serwera, wymagany przez standard.
VAPID_KONTAKT=mailto:ty@twojadomena.pl
