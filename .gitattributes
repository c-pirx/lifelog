# Skrypty i pliki konfiguracyjne wykonywane na Linuksie MUSZĄ mieć końce
# linii LF. Git na Windowsie domyślnie zamienia je na CRLF, a wtedy bash
# przerywa na "$'\r': command not found" — błąd myląco wyglądający jak
# literówka w skrypcie.

* text=auto

*.sh        text eol=lf
*.mjs       text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf

# Pliki binarne — bez jakiejkolwiek konwersji.
*.png       binary
*.mcpb      binary
